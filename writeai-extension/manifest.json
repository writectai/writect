{
  "manifest_version": 3,
  "name": "Writect — AI Writing Assistant",
  "version": "1.7.0",
  "description": "Writect — meaning-safe rephrase, fix, translate, summarize, and draft on Gmail, WhatsApp, and more.",
  "permissions": ["storage", "activeTab", "scripting", "contextMenus", "sidePanel"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background/service-worker.js"
  },
  "side_panel": {
    "default_path": "sidepanel/sidepanel.html"
  },
  "content_scripts": [
    {
      "matches": [
        "http://localhost:3000/*",
        "https://writect.ai/*"
      ],
      "js": ["content/web-auth-bridge.js"],
      "run_at": "document_start"
    },
    {
      "matches": ["<all_urls>"],
      "js": ["content/content.js"],
      "css": ["content/toolbar.css"],
      "run_at": "document_idle"
    },
    {
      "matches": ["<all_urls>"],
      "js": ["content/page-extract.js"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://mail.google.com/*",
        "https://web.whatsapp.com/*",
        "https://www.linkedin.com/*",
        "https://linkedin.com/*",
        "https://outlook.live.com/*",
        "https://outlook.office.com/*",
        "https://outlook.office365.com/*"
      ],
      "js": ["utils/voice.js", "content/site-compose.js"],
      "css": ["content/site-compose.css"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Writect — open sidebar",
    "default_icon": {
      "16": "icons/Writect-logo-icon.png",
      "32": "icons/Writect-logo-icon.png",
      "48": "icons/Writect-logo-icon.png",
      "128": "icons/Writect-logo-icon.png"
    }
  },
  "icons": {
    "16": "icons/Writect-logo-icon.png",
    "32": "icons/Writect-logo-icon.png",
    "48": "icons/Writect-logo-icon.png",
    "128": "icons/Writect-logo-icon.png"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "icons/Writect-logo-icon.png",
        "icons/Writect-AI-logo.png",
        "icons/Writect-AI-logo-white.png"
      ],
      "matches": ["<all_urls>"]
    }
  ],
  "externally_connectable": {
    "matches": [
      "http://localhost:3000/*",
      "https://writect.ai/*"
    ]
  }
}
