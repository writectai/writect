# Paste these in Render Dashboard → Environment
# Single domain: https://writect.ai (API + website)

NODE_ENV=production
DATABASE_URL=postgresql://USER:PASS@HOST/neondb?sslmode=require
JWT_SECRET=generate-a-long-random-string
JWT_EXPIRES_IN=30d

GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=https://writect.ai/auth/google/callback

FRONTEND_URL=https://writect.ai
EXTENSION_ORIGIN=chrome-extension://YOUR_EXTENSION_ID

ADMIN_EMAILS=you@gmail.com
ADMIN_USERNAME=admin
ADMIN_PASSWORD=strong-password-here
ADMIN_DISPLAY_NAME=Writect Admin

OPENAI_API_KEY=
GEMINI_API_KEY=

# Redis optional — leave unset on free demo
# REDIS_URL=
