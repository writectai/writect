PORT=3000
DATABASE_URL=postgresql://user:pass@localhost:5432/writeai
REDIS_URL=redis://localhost:6379
JWT_SECRET=your-secret-here
JWT_EXPIRES_IN=30d

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/auth/google/callback

OPENAI_API_KEY=
GEMINI_API_KEY=

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRO_PRICE_ID=
STRIPE_PRO_YEARLY_PRICE_ID=

# SMTP (Gmail app password recommended). Leave blank to disable outbound mail.
MAIL_DRIVER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=Writect <noreply@writect.ai>
MAIL_REPLY_TO=support@writect.ai

FRONTEND_URL=http://localhost:3000
EXTENSION_ORIGIN=chrome-extension://YOUR_EXTENSION_ID

# Comma-separated emails that get admin role on Google sign-in AND receive admin notifications
ADMIN_EMAILS=admin@example.com

# Master panel login (stored in panel_admins table — run npm run seed:admin)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=changeme
ADMIN_DISPLAY_NAME=WriteAI Admin
ADMIN_SESSION_EXPIRES_IN=8h
